{
  "name": "clipping",
  "version": "1.0.0",
  "private": true,
  "description": "Personal YouTube auto-clipper dashboard — local-only, single user.",
  "workspaces": [
    "worker",
    "web"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "npm run doctor --workspace worker",
    "dev": "node scripts/dev.mjs",
    "dev:worker": "npm run dev --workspace worker",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "step": "npm run step --workspace worker --",
    "smoke": "npm run smoke --workspace worker --",
    "colorwar:studio": "node scripts/colorwar/studio.mjs",
    "colorwar:queue": "node scripts/colorwar/render.mjs --queue render-queue.txt",
    "followball:studio": "node scripts/followball/studio.mjs",
    "followball:queue": "node scripts/followball/render.mjs --queue render-queue.txt",
    "test": "npm run test --workspace worker && npm run test:py",
    "test:py": "python/.venv/bin/python python/test_reframe.py"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prebuild-install@7.1.3": true
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "playwright-core": "^1.62.1",
    "three": "^0.185.1"
  }
}
