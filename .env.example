# ---------------------------------------------------------------------------
# Personal YouTube Auto-Clipper — environment
# Copy to .env and fill in YT_API_KEY. Everything else has working defaults.
# ---------------------------------------------------------------------------

# YouTube Data API v3 key (REQUIRED for the Search step).
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
YT_API_KEY=

# --- Twitch Clips source (optional) ------------------------------------
# Only needed if you set the source platform to Twitch or Both in Settings.
# Register an app at https://dev.twitch.tv/console/apps (any OAuth Redirect URL,
# e.g. http://localhost — client-credentials doesn't use it), then copy the
# Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Worker service -------------------------------------------------------
WORKER_HOST=127.0.0.1
WORKER_PORT=8787

# --- LLM (segment ranking · hook writing · halal check · trending topic) --
# Default: a local Ollama model — free, no key, but slow on a CPU-only box.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
#   Faster local options:  llama3.2:3b  ·  qwen2.5:3b  ·  qwen2.5:7b (best quality/speed)
#
# OR use a hosted model on a free tier — much faster + smarter, no local compute.
# Any OpenAI-compatible endpoint works. Set LLM_PROVIDER=openai and fill these:
#   LLM_PROVIDER=openai
#   Google Gemini (generous free tier — get a key at aistudio.google.com/apikey):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-3.5-flash-lite       # fast + cheap; "flash" (no -lite) is a slow thinking model
#     LLM_API_KEY=<your Gemini key>
#   Note: the YouTube key usually can't be reused — its API restriction blocks Gemini.
#   Groq (very fast Llama/Qwen, free tier):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#     LLM_API_KEY=<console.groq.com/keys>
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Whisper (faster-whisper, local transcription) ----------------------
# model:   large-v3 (best) | large-v3-turbo (~5x faster) | medium | small
# compute: int8 (fast, low RAM) | int8_float32 | float32
WHISPER_MODEL=large-v3
WHISPER_COMPUTE=int8

# --- Music removal (Demucs stem separation) ----------------------------
# Background music is auto-detected and stripped (audio rebuilt from the vocal
# stem). htdemucs = fast. htdemucs_ft = much cleaner isolation, ~4x slower,
# downloads ~1.2 GB the first time. Recommended if any music bleed-through is a
# problem for you.
# DEMUCS_MODEL=htdemucs_ft

# --- yt-dlp auth (optional) --------------------------------------------
# YouTube sometimes blocks downloads with "confirm you're not a bot",
# especially after a burst of activity. Point yt-dlp at a logged-in
# browser's cookies to get past it. Use one of these:
#   YTDLP_COOKIES_FROM_BROWSER=chrome   # or: safari firefox brave edge chromium
#   YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=

# --- Paths (relative to repo root, or absolute) ------------------------
DATA_DIR=data
ASSETS_DIR=assets

# --- Web -----------------------------------------------------------------
# Next.js port; the browser only ever talks to this origin.
WEB_PORT=3100

# --- Running on a remote box (Oracle Cloud VM etc.) — see CLOUD.md ------
# Hostnames you'll open the dashboard from, comma-separated. Only needed if you
# run `npm run dev` (not the built server) on a machine you reach by IP/name.
#   DEV_ORIGINS=100.x.x.x,clipper-vm,clipper-vm.tailnet-name.ts.net
DEV_ORIGINS=
# Override ffmpeg location if it isn't auto-found (Linux apt build is fine as-is).
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe

# --- Daily autonomous TikTok poster (scripts/post/daily.ts) --------------
# Only needed to run that script (locally, for testing, or as GitHub Actions
# secrets for the real schedule — see .github/workflows/daily-post.yml).
# Buffer API key: publish.buffer.com/settings/api (free plan works)
BUFFER_API_KEY=
# The connected TikTok channel's id — see the "Get Channels" query at
# developers.buffer.com/examples/get-channels.html
BUFFER_CHANNEL_ID=
# owner/repo of the small PUBLIC hand-off repo the daily mp4 gets published to
# (Buffer needs a public, no-auth video URL to fetch from)
OUTPUT_REPO=
# a GitHub personal access token with `repo` scope on OUTPUT_REPO (used to
# create/delete releases there — the default Actions token can't reach a
# different repo)
OUTPUT_REPO_TOKEN=
