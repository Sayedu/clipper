[Unit]
Description=Clipper — Next.js dashboard
After=network-online.target clipper-worker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/web
# built with `npm run build`; binds all interfaces so you can reach it over Tailscale / SSH tunnel
ExecStart=/usr/bin/env npm run start -- -H 0.0.0.0 -p __WEBPORT__
Restart=always
RestartSec=3
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clipper-web

[Install]
WantedBy=multi-user.target
